# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub.
# PostgreSQL local (contenedor de Docs/Tests/TESTING_PGVECTOR.md).
# En producción usa la cadena de conexión de Supabase.
DATABASE_URL=postgresql://raguaco:raguaco@localhost:5433/raguaco
# Embeddings locales (multilingual-e5-small, ONNX). Ruta relativa a App/.
# Descarga previa: hf download intfloat/multilingual-e5-small --local-dir App/ai-models/multilingual-e5-small
EMBEDDING_MODEL=ai-models/multilingual-e5-small
EMBEDDING_DIMENSION=384
# LLM vía API (OpenCode Go). Key desde https://opencode.ai/auth.
# Catálogo de modelos: https://opencode.ai/zen/go/v1/models
# (solo valen los servidos en /v1/chat/completions: deepseek-v4.1-flash,
# glm-5.3, kimi-k3, qwen3.6-plus, mimo-v2.6-flash, ...).
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
# Copias de los archivos originales subidos (StorageService). Ruta relativa a App/.
STORAGE_DIR=storage
# STT local (faster-whisper). Rutas relativas a App/.
STT_MODEL=ai-models/faster-whisper-small
STT_LANGUAGE=es
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 1 = más rápido (greedy), 5 = más preciso y más lento.
STT_BEAM_SIZE=1
# 0 = usa todos los núcleos disponibles.
STT_THREADS=0
# Precarga faster-whisper en segundo plano al arrancar la API.
STT_WARMUP=true
# Detección de fin de voz (micrófono). Silencio tras hablar que cierra la pregunta.
VOICE_SILENCE_SECONDS=1.5
VOICE_CHUNK_SECONDS=0.5
VOICE_MIN_UTTERANCE_SECONDS=0.35
VOICE_MAX_UTTERANCE_SECONDS=20
# Nivel de pico tras hablar que cierra la pregunta.
VOICE_SILENCE_PEAK=0.12
# TTS local (Kokoro-82M, ONNX). Rutas relativas a App/.
# Voz en español: ef_dora (femenina) / em_alex (masculina).
TTS_MODEL=ai-models/kokoro-82m
# model_quantized.onnx (int8) prioriza latencia; onnx/model.onnx (fp32) prioriza calidad.
TTS_MODEL_FILE=onnx/model_quantized.onnx
TTS_VOICE=ef_dora
TTS_LANGUAGE=es
TTS_SPEED=1.0
# WAV fragmentados que sirve POST /v1/voice/tts.
TTS_OUTPUT_DIR=storage/tts
TTS_RETENTION_MINUTES=30
# Primer fragmento corto (baja latencia) y resto acotado (sin cortes al reproducir).
TTS_FIRST_CHUNK_CHARS=100
TTS_CHUNK_CHARS=120
# Precarga el modelo en segundo plano al arrancar la API.
TTS_WARMUP=true
