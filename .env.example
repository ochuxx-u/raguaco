# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub.
# PostgreSQL local (contenedor de Docs/Tests/TESTING_PGVECTOR.md).
# En producción usa la cadena de conexión de Supabase.
DATABASE_URL=postgresql://raguaco:raguaco@localhost:5433/raguaco
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# STT local (faster-whisper). Rutas relativas a App/.
STT_MODEL=ai-models/faster-whisper-small
STT_LANGUAGE=es
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 1 = más rápido (greedy), 5 = más preciso y más lento.
STT_BEAM_SIZE=1
