# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub.
# PostgreSQL local (contenedor de Docs/Tests/TESTING_PGVECTOR.md).
# En producción usa la cadena de conexión de Supabase.
DATABASE_URL=postgresql://raguaco:raguaco@localhost:5433/raguaco
# Embeddings locales (multilingual-e5-small, ONNX). Ruta relativa a App/.
# Descarga previa: hf download intfloat/multilingual-e5-small --local-dir App/ai-models/multilingual-e5-small
EMBEDDING_MODEL=ai-models/multilingual-e5-small
EMBEDDING_DIMENSION=384
# LLM vía API (OpenCode Go). Key desde https://opencode.ai/auth.
# Catálogo de modelos: https://opencode.ai/zen/go/v1/models
# (solo valen los servidos en /v1/chat/completions: deepseek-v4.1-flash,
# glm-5.3, kimi-k3, qwen3.6-plus, mimo-v2.6-flash, ...).
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
# STT local (faster-whisper). Rutas relativas a App/.
STT_MODEL=ai-models/faster-whisper-small
STT_LANGUAGE=es
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 1 = más rápido (greedy), 5 = más preciso y más lento.
STT_BEAM_SIZE=1
