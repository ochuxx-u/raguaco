        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Usuario {\n        +UUID id\n        +string nombre\n        +string email\n    }\n\n    class Documento {\n        +UUID id\n        +UUID usuarioId\n        +string nombre\n        +string formato\n        +string rutaOriginal\n        +string categoria\n        +EstadoDocumento estado\n        +datetime fechaCarga\n        +json metadata\n    }\n\n    class Chunk {\n        +UUID id\n        +UUID documentoId\n        +text contenido\n        +int indice\n        +int pagina\n        +json metadata\n        +vector embedding\n    }\n\n    class Conversacion {\n        +UUID id\n        +UUID usuarioId\n        +datetime fechaCreacion\n    }\n\n    class Mensaje {\n        +UUID id\n        +UUID conversacionId\n        +string rol\n        +text contenido\n        +datetime fecha\n    }\n\n    class ReferenciaFuente {\n        +UUID id\n        +UUID mensajeId\n        +UUID chunkId\n        +float similitud\n    }\n\n    class EstadoDocumento {\n        &lt;&lt;enumeration&gt;&gt;\n        pendiente\n        procesando\n        listo\n        error\n    }\n\n    Usuario \&quot;1\&quot; --&gt; \&quot;*\&quot; Documento\n    Usuario \&quot;1\&quot; --&gt; \&quot;*\&quot; Conversacion\n    Conversacion \&quot;1\&quot; --&gt; \&quot;*\&quot; Mensaje\n    Documento \&quot;1\&quot; --&gt; \&quot;*\&quot; Chunk\n    Mensaje \&quot;1\&quot; --&gt; \&quot;*\&quot; ReferenciaFuente\n    Chunk \&quot;1\&quot; --&gt; \&quot;*\&quot; ReferenciaFuente\n    Documento --&gt; EstadoDocumento\n\n    class DocumentLoader {\n        +extraerTexto(archivo)\n    }\n    class TextCleaner {\n        +limpiar(texto)\n    }\n    class ChunkingService {\n        +fragmentar(texto)\n    }\n    class EmbeddingService {\n        +generarEmbedding(texto)\n    }\n    class DocumentIngestionService {\n        +procesarDocumento(archivo)\n    }\n    class VectorRepository {\n        +guardarChunks(chunks)\n        +buscarSimilares(embedding, topK, umbral, filtros)\n    }\n    class Retriever {\n        +recuperar(consulta, opciones)\n    }\n    class LLMService {\n        +generarRespuesta(prompt, contexto)\n    }\n    class RAGService {\n        +responder(pregunta, conversacionId)\n    }\n    class ConversationService {\n        +crearConversacion(usuarioId)\n        +agregarMensaje(conversacionId, mensaje)\n        +obtenerHistorial(conversacionId)\n    }\n    class StorageService {\n        +guardarOriginal(archivo)\n        +eliminarOriginal(ruta)\n    }\n    class VoiceService {\n        +speechToText(audio)\n        +textToSpeech(texto)\n    }\n\n    DocumentIngestionService --&gt; DocumentLoader\n    DocumentIngestionService --&gt; TextCleaner\n    DocumentIngestionService --&gt; ChunkingService\n    DocumentIngestionService --&gt; EmbeddingService\n    DocumentIngestionService --&gt; VectorRepository\n    DocumentIngestionService --&gt; StorageService\n\n    RAGService --&gt; EmbeddingService\n    RAGService --&gt; Retriever\n    RAGService --&gt; LLMService\n    RAGService --&gt; ConversationService\n    Retriever --&gt; VectorRepository\n    VoiceService --&gt; RAGService&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="92jySuE7JqNcqh8hnh48-1">
