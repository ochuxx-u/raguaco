        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor U as Usuario\n    participant UI as Interfaz\n    participant VS as VoiceService\n    participant STT as Speech-to-Text\n    participant RAG as RAGService\n    participant TTS as Text-to-Speech\n\n    U-&gt;&gt;UI: audio de pregunta\n    UI-&gt;&gt;VS: procesarVoz(audio)\n    VS-&gt;&gt;STT: transcribir(audio)\n    STT--&gt;&gt;VS: texto\n    VS-&gt;&gt;RAG: responder(texto)\n    RAG--&gt;&gt;VS: respuesta textual + fuentes\n    VS-&gt;&gt;TTS: sintetizar(respuesta)\n    TTS--&gt;&gt;VS: audioRespuesta\n    VS--&gt;&gt;UI: audioRespuesta + texto + fuentes\n    UI--&gt;&gt;U: reproduce audio y muestra texto&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="on92uS5zQ1TWulW747Aj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
