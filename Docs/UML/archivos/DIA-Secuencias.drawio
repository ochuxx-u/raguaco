        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor U as Usuario\n    participant API as API FastAPI\n    participant RAG as RAGService\n    participant CS as ConversationService\n    participant ES as EmbeddingService\n    participant R as Retriever\n    participant VR as VectorRepository\n    participant LLM as LLMService\n\n    U-&gt;&gt;API: POST /query {pregunta, conversacionId?}\n    API-&gt;&gt;RAG: responder(pregunta, conversacionId)\n    RAG-&gt;&gt;CS: obtenerHistorial(conversacionId)\n    CS--&gt;&gt;RAG: contextoConversacional\n    RAG-&gt;&gt;CS: agregarMensaje(conversacionId, mensaje, referencias=None)\n    CS--&gt;&gt;RAG: ok\n    RAG-&gt;&gt;ES: generarEmbedding(pregunta)\n    ES--&gt;&gt;RAG: embeddingConsulta\n    RAG-&gt;&gt;R: recuperar(embeddingConsulta, usuarioId, {topK, umbral, filtros})\n    R-&gt;&gt;VR: buscarSimilares(embedding, {parametros})\n    VR--&gt;&gt;R: chunksRelevantes\n    R--&gt;&gt;RAG: chunks\n    RAG-&gt;&gt;RAG: guardarChunkContenido(chunksId)\n    RAG-&gt;&gt;RAG: construirContexto(chunksContent, historial)\n    RAG-&gt;&gt;LLM: generarRespuesta(pregunta, contexto)\n    LLM--&gt;&gt;RAG: respuesta\n    RAG-&gt;&gt;CS: agregarMensaje(conversacionId, mensaje, referencias)\n    CS--&gt;&gt;RAG: ok\n    RAG--&gt;&gt;API: respuesta + fuentes\n    API--&gt;&gt;U: 200 OK {respuesta, fuentes}&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wgLdaHBiHVg5UMHt-y2P-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
